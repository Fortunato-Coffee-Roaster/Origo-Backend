generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum TipoUser {
  CLIENTE
  STAFF
  ADMIN
}

model User {
  id_user               String               @id @default(uuid())
  tipo                  TipoUser
  nombre                String
  email                 String               @unique
  password              String
  numero_telefono       String
  documento_tipo        String?
  documento_identidad   String?              @unique
  fecha_nacimiento      DateTime?
  eliminado             Boolean              @default(false)
  fecha_registro        DateTime             @default(now())
  fecha_editado         DateTime?
  cliente               UserCliente?
  staff                 UserStaff?
  admin                 UserAdmin?
  passwordResetTokens   PasswordResetToken[]
  historial             Historial[]
  cambios               Cambios[]
  pedidosCreados        Pedido[]             @relation("PedidoCreadoPor")
  pedidosCompletados    Pedido[]             @relation("PedidoCompletadoPor")
  paquetesCreados       Paquete[]            @relation("PaqueteCreadoPor")
  paquetesPreparados    Paquete[]            @relation("PaquetePreparadoPor")
  enviosRegistrados     Envio[]              @relation("EnvioRegistradoPor")
  enviosDespachados     Envio[]              @relation("EnvioDespachadoPor")
  enviosEntregados      Envio[]              @relation("EnvioEntregadoPor")
  enviosCancelados      Envio[]              @relation("EnvioCanceladoPor")
  balonesGasIngresados  BalonGas[]           @relation("BalonGasUserIngreso")
  balonesGasIniciados   BalonGas[]           @relation("BalonGasUserInicioUso")
  balonesGasFinalizados BalonGas[]           @relation("BalonGasUserFinUso")
  ingresosCafe          IngresoCafe[]
  ingresosInsumos       IngresoInsumo[]
  ingresosProductos     IngresoProducto[]
  movimientoAlmacens    MovimientoAlmacen[]
}

model UserCliente {
  id_user              String         @id
  user                 User           @relation(fields: [id_user], references: [id_user])
  nombre_comercial     String?
  departamento         String?
  direccion            String?
  tuestes              Int?           @default(0)
  fecha_primera_compra DateTime?
  suscripcion          Boolean        @default(false)
  cant_suscripcion     Int?           @default(0)
  lotes                Lote[]
  lotesTostados        LoteTostado[]
  muestras             Muestra[]
  bolsas               Bolsa[]
  pedidos              Pedido[]       @relation("Cliente")
  paquetesCliente      Paquete[]      @relation("PaqueteCliente")
  boxRespuestas        BoxRespuesta[]
}

model UserStaff {
  id_user String  @id
  user    User    @relation(fields: [id_user], references: [id_user])
  cargo   String?
  id_rol  String?
  Rol     Rol?    @relation(fields: [id_rol], references: [id_rol])
}

model UserAdmin {
  id_user String @id
  user    User   @relation(fields: [id_user], references: [id_user])
}

model PasswordResetToken {
  id_token     String    @id @default(uuid())
  id_user      String
  token        String    @unique
  fecha_creado DateTime  @default(now())
  fecha_expira DateTime
  usado        Boolean   @default(false)
  fecha_usado  DateTime?
  ip_solicitud String?
  user         User      @relation(fields: [id_user], references: [id_user])
}

model Rol {
  id_rol      String       @id @default(uuid())
  nombre      String       @unique
  descripcion String?
  activo      Boolean      @default(true)
  created_at  DateTime     @default(now())
  permisos    RolPermiso[]
  usuarios    UserStaff[]
}

model RolPermiso {
  id_rol     String
  id_permiso String
  permiso    Permiso @relation(fields: [id_permiso], references: [id_permiso])
  rol        Rol     @relation(fields: [id_rol], references: [id_rol])

  @@id([id_rol, id_permiso])
}

model Permiso {
  id_permiso  String       @id @default(uuid())
  codigo      String       @unique
  descripcion String?
  created_at  DateTime     @default(now())
  modulo      String
  roles       RolPermiso[]
}

model Almacen {
  id_almacen          String                  @id @default(uuid())
  nombre              String
  descripcion         String?
  activo              Boolean                 @default(true)
  created_at          DateTime                @default(now())
  ingresoInsumos      IngresoInsumo[]
  ingresoProductos    IngresoProducto[]
  inventarioInsumos   InventarioInsumo[]
  inventarioLotes     InventarioLote[]
  inventarioTostados  InventarioLoteTostado[]
  inventarioMuestras  InventarioMuestra[]
  inventarioProductos InventarioProducto[]
  movimientosDestino  MovimientoAlmacen[]     @relation("MovimientoDestino")
  movimientosOrigen   MovimientoAlmacen[]     @relation("MovimientoOrigen")
  pedidos             Pedido[]                @relation("almacen")
  inventarioBolsas    InventarioBolsa[]
  paqueteItems        PaqueteItem[]
}

model MovimientoAlmacen {
  id_movimiento         String            @id @default(uuid())
  tipo                  TipoMovimiento
  entidad               EntidadInventario
  id_almacen_origen     String?
  id_almacen_destino    String?
  cantidad              Float
  comentario            String?
  id_user               String
  fecha                 DateTime          @default(now())
  id_entidad_primario   String
  id_entidad_secundario String?
  id_pedido             String?
  almacenDestino        Almacen?          @relation("MovimientoDestino", fields: [id_almacen_destino], references: [id_almacen])
  almacenOrigen         Almacen?          @relation("MovimientoOrigen", fields: [id_almacen_origen], references: [id_almacen])
  pedido                Pedido?           @relation(fields: [id_pedido], references: [id_pedido])
  user                  User              @relation(fields: [id_user], references: [id_user])
}

model Muestra {
  id_muestra         String              @id
  owned_by_store     Boolean             @default(false)
  productor          String?
  finca              String?
  distrito           String?             @map("region")
  departamento       String?
  provincia          String?
  anio_cosecha       Int?
  altura             Int?
  peso               Float
  variedades         String[]
  proceso            String
  id_user            String?
  id_analisis        String?
  fecha_registro     DateTime            @default(now())
  eliminado          Boolean             @default(false)
  nombre_muestra     String?
  proveedor          String?
  completado         Boolean             @default(false)
  inventarioMuestras InventarioMuestra[]
  analisis           Analisis?           @relation(fields: [id_analisis], references: [id_analisis])
  user               UserCliente?        @relation(fields: [id_user], references: [id_user])
  muestrasHistoricas Muestra_Analisis[]
}

model InventarioMuestra {
  id_inventario  String    @id @default(uuid())
  id_muestra     String
  id_almacen     String
  peso           Float
  fecha_registro DateTime  @default(now())
  fecha_editado  DateTime?
  almacen        Almacen   @relation(fields: [id_almacen], references: [id_almacen])
  muestra        Muestra   @relation(fields: [id_muestra], references: [id_muestra])

  @@unique([id_muestra, id_almacen])
}

model Lote {
  id_lote          String           @id
  owned_by_store   Boolean          @default(false)
  productor        String?
  finca            String?
  distrito         String?          @map("region")
  departamento     String?
  provincia        String?
  anio_cosecha     Int?
  altura           Int?
  peso             Float
  peso_tostado     Float?
  variedades       String[]
  proceso          String
  tipo_lote        String
  id_user          String?
  id_analisis      String?
  fecha_registro   DateTime         @default(now())
  eliminado        Boolean          @default(false)
  proveedor        String?
  clasificacion    String?
  costo            Float?
  precio_1         Float?
  escala_2         Float?
  escala_3         Float?
  alias            String?
  boxOpcions       BoxOpcion[]
  boxRespuestas    BoxRespuesta[]
  boxTemplates1    BoxTemplate[]    @relation("BOX_FIJO_1")
  boxTemplates2    BoxTemplate[]    @relation("BOX_FIJO_2")
  ingresosCafe     IngresoCafe[]
  inventarioLotes  InventarioLote[]
  analisis         Analisis?        @relation(fields: [id_analisis], references: [id_analisis])
  user             UserCliente?     @relation(fields: [id_user], references: [id_user])
  LoteTostado      LoteTostado[]
  lotesHistoricos  Lote_Analisis[]
  pedidosDestino   Pedido[]         @relation("LoteDestino")
  pedidosOrigen    Pedido[]         @relation("LoteOrigen")
  pedidosCreadores Pedido[]         @relation("LoteCreado")
}

model InventarioLote {
  id_inventario       String    @id @default(uuid())
  id_lote             String
  id_almacen          String
  cantidad_kg         Float
  fecha_registro      DateTime  @default(now())
  fecha_editado       DateTime?
  cantidad_tostado_kg Float?
  almacen             Almacen   @relation(fields: [id_almacen], references: [id_almacen])
  lote                Lote      @relation(fields: [id_lote], references: [id_lote])

  @@unique([id_lote, id_almacen])
}

model LoteTostado {
  id_lote_tostado        String                  @id
  id_lote                String
  owned_by_store         Boolean                 @default(false)
  fecha_tostado          DateTime
  perfil_tostado         String
  peso                   Float
  fecha_registro         DateTime                @default(now())
  eliminado              Boolean                 @default(false)
  id_analisis_rapido     String?                 @unique
  id_user                String?
  inventarioLoteTostados InventarioLoteTostado[]
  inventarios            InventarioProducto[]
  analisisRapido         AnalisisRapido?         @relation(fields: [id_analisis_rapido], references: [id_analisis_rapido])
  lote                   Lote                    @relation(fields: [id_lote], references: [id_lote])
  usuario                UserCliente?            @relation(fields: [id_user], references: [id_user])
  PedidoEmbolsado        Pedido[]                @relation("PedidoLoteTostadoOrigen")
  PedidoOrigen           Pedido?                 @relation("PedidoLoteTostado")
  tuestes                Tueste[]
  bolsas                 Bolsa[]
}

model InventarioLoteTostado {
  id_inventario   String      @id @default(uuid())
  id_lote_tostado String
  id_almacen      String
  cantidad_kg     Float
  fecha_registro  DateTime    @default(now())
  fecha_editado   DateTime?
  almacen         Almacen     @relation(fields: [id_almacen], references: [id_almacen])
  loteTostado     LoteTostado @relation(fields: [id_lote_tostado], references: [id_lote_tostado])

  @@unique([id_lote_tostado, id_almacen])
}

//BOLSA

model Bolsa {
  id_bolsa        String  @id
  owned_by_store  Boolean @default(false)
  id_lote_tostado String
  id_pedido       String
  gramaje         Int
  molienda        String

  cantidad        Int
  fecha_embolsado DateTime @default(now())
  id_user         String?
  comentario      String?
  eliminado       Boolean  @default(false)

  loteTostado LoteTostado       @relation(fields: [id_lote_tostado], references: [id_lote_tostado])
  pedido      Pedido            @relation(fields: [id_pedido], references: [id_pedido])
  user        UserCliente?      @relation(fields: [id_user], references: [id_user])
  inventarios InventarioBolsa[]
}

model InventarioBolsa {
  id_inventario  String    @id @default(uuid())
  id_bolsa       String
  id_almacen     String
  cantidad       Int       @default(0)
  fecha_registro DateTime  @default(now())
  fecha_editado  DateTime?

  bolsa   Bolsa   @relation(fields: [id_bolsa], references: [id_bolsa])
  almacen Almacen @relation(fields: [id_almacen], references: [id_almacen])

  @@unique([id_bolsa, id_almacen])
}

// INSUMOS 

model Insumo {
  id_insumo     String             @id @default(uuid())
  nombre        String
  descripcion   String?
  unidad_medida String
  activo        Boolean            @default(true)
  created_at    DateTime           @default(now())
  id_categoria  String
  ingresos      IngresoInsumo[]
  categoria     CategoriaInsumo    @relation(fields: [id_categoria], references: [id_categoria])
  inventarios   InventarioInsumo[]
}

model IngresoInsumo {
  id_ingreso    String   @id @default(uuid())
  id_insumo     String
  id_almacen    String
  cantidad      Int
  precio_compra Float?
  fecha_ingreso DateTime @default(now())
  id_user       String?
  almacen       Almacen  @relation(fields: [id_almacen], references: [id_almacen])
  insumo        Insumo   @relation(fields: [id_insumo], references: [id_insumo])
  user          User?    @relation(fields: [id_user], references: [id_user])
}

model CategoriaInsumo {
  id_categoria String   @id @default(uuid())
  nombre       String   @unique
  activo       Boolean  @default(true)
  insumos      Insumo[]
}

model InventarioInsumo {
  id_inventario  String    @id @default(uuid())
  id_insumo      String
  id_almacen     String
  cantidad       Int
  fecha_registro DateTime  @default(now())
  fecha_editado  DateTime?
  almacen        Almacen   @relation(fields: [id_almacen], references: [id_almacen])
  insumo         Insumo    @relation(fields: [id_insumo], references: [id_insumo])

  @@unique([id_insumo, id_almacen])
}

model Categoria {
  id_categoria   String     @id
  nombre         String
  descripcion    String?
  eliminado      Boolean    @default(false)
  fecha_registro DateTime   @default(now())
  productos      Producto[]
}

model Producto {
  id_producto    String               @id
  nombre         String
  descripcion    String?
  activo         Boolean              @default(true)
  fecha_registro DateTime             @default(now())
  fecha_editado  DateTime?
  es_combo       Boolean              @default(false)
  id_categoria   String
  alto_cm        Float?
  ancho_cm       Float?
  color          String?
  fragil         Boolean?
  largo_cm       Float?
  material       String?
  modelo         String?
  peso_kg        Float?
  volumen_cm3    Float?
  id_marca       String?
  ingresos       IngresoProducto[]
  inventarios    InventarioProducto[]
  pedidos        Pedido[]
  categoria      Categoria            @relation(fields: [id_categoria], references: [id_categoria])
  marca          Marca?               @relation(fields: [id_marca], references: [id_marca])
  componentes    ProductoComponente[] @relation("ProductoCombo")
  parteDeCombos  ProductoComponente[] @relation("ProductoParte")
}

model Marca {
  id_marca       String     @id @default(uuid())
  nombre         String     @unique
  descripcion    String?
  activo         Boolean    @default(true)
  fecha_registro DateTime   @default(now())
  fecha_editado  DateTime?
  productos      Producto[]
}

model IngresoProducto {
  id_ingreso    String   @id @default(uuid())
  id_producto   String
  id_almacen    String
  cantidad      Int
  precio_compra Float
  fecha_ingreso DateTime @default(now())
  id_user       String?
  almacen       Almacen  @relation(fields: [id_almacen], references: [id_almacen])
  producto      Producto @relation(fields: [id_producto], references: [id_producto])
  user          User?    @relation(fields: [id_user], references: [id_user])
}

model InventarioProducto {
  id_inventario   String       @id @default(uuid())
  id_producto     String
  id_almacen      String
  id_lote_tostado String?
  cantidad        Int          @default(0)
  gramaje         Int?
  molienda        Molienda     @default(NINGUNO)
  unidad_medida   String?
  fecha_registro  DateTime     @default(now())
  fecha_editado   DateTime?
  almacen         Almacen      @relation(fields: [id_almacen], references: [id_almacen])
  loteTostado     LoteTostado? @relation(fields: [id_lote_tostado], references: [id_lote_tostado])
  producto        Producto     @relation(fields: [id_producto], references: [id_producto])

  @@unique([id_producto, id_almacen, gramaje, molienda])
}

model ProductoComponente {
  id_combo    String
  id_producto String
  cantidad    Int      @default(1)
  combo       Producto @relation("ProductoCombo", fields: [id_combo], references: [id_producto])
  producto    Producto @relation("ProductoParte", fields: [id_producto], references: [id_producto])

  @@id([id_combo, id_producto])
}

model BoxTemplate {
  id_box_template String         @id @default(uuid())
  nombre          String
  descripcion     String?
  activo          Boolean        @default(true)
  fecha_creado    DateTime       @default(now())
  cafe_fijo_1     String
  cafe_fijo_2     String
  tueste_fijo_1   String[]       @default([])
  tueste_fijo_2   String[]       @default([])
  eliminado       Boolean        @default(false)
  opciones        BoxOpcion[]
  respuestas      BoxRespuesta[]
  lote_fijo_1     Lote           @relation("BOX_FIJO_1", fields: [cafe_fijo_1], references: [id_lote])
  lote_fijo_2     Lote           @relation("BOX_FIJO_2", fields: [cafe_fijo_2], references: [id_lote])
}

model BoxOpcion {
  id_opcion       String      @id @default(uuid())
  id_box_template String
  id_cafe         String
  tuestes         String[]    @default([])
  template        BoxTemplate @relation(fields: [id_box_template], references: [id_box_template])
  lote            Lote        @relation(fields: [id_cafe], references: [id_lote])
}

model BoxRespuesta {
  id_respuesta    String      @id @default(uuid())
  id_box_template String
  id_user         String
  molienda_1      Molienda
  molienda_2      Molienda
  id_cafe_elegido String
  molienda_3      Molienda
  fecha_registro  DateTime    @default(now())
  tueste_1        String
  tueste_2        String
  tueste_3        String
  boxTemplate     BoxTemplate @relation(fields: [id_box_template], references: [id_box_template])
  lote_elegido    Lote        @relation(fields: [id_cafe_elegido], references: [id_lote])
  user            UserCliente @relation(fields: [id_user], references: [id_user])
}

model Variedad {
  id_variedad String @id @default(uuid())
  nombre      String
}

model Notas {
  id        String    @id @default(uuid())
  name      String
  color     String
  createdAt DateTime  @default(now())
  parentId  String?
  updatedAt DateTime? @updatedAt
  parent    Notas?    @relation("jerarquia", fields: [parentId], references: [id])
  children  Notas[]   @relation("jerarquia")
}

model IngresoCafe {
  id_ingreso     String   @id @default(uuid())
  id_lote        String
  cantidad_kg    Float
  costo_unitario Float
  fecha_ingreso  DateTime @default(now())
  proveedor      String?
  id_user        String?

  lote Lote  @relation(fields: [id_lote], references: [id_lote])
  user User? @relation(fields: [id_user], references: [id_user])
}

// HISTORIAL DE ACCIONES POR USUARIO

enum HistorialEntidad {
  PEDIDO
  LOTE
  LOTE_TOSTADO
  MUESTRA
  INSUMO
  BOLSA
  PRODUCTO
  INVENTARIO
  TUESTE
  PAQUETE
  ENVIO
}

enum HistorialAccion {
  CREATE
  UPDATE
  DELETE
  COMPLETE
  CANCEL
  AJUSTE
  INGRESO
  SALIDA
  TRASLADO
}

model Historial {
  id_historial   String            @id @default(uuid())
  id_entidad     String
  id_user        String
  comentario     String?
  fecha_registro DateTime          @default(now())
  objeto_antes   Json?
  objeto_despues Json?
  entidad        HistorialEntidad?
  accion         HistorialAccion?
  id_pedido      String?
  pedido         Pedido?           @relation(fields: [id_pedido], references: [id_pedido])
  user           User              @relation(fields: [id_user], references: [id_user])
}

model Cambios {
  id_cambio    String   @id @default(uuid())
  entidad      String
  id_entidad   String
  objeto_antes Json
  comentario   String?
  id_user      String
  created_at   DateTime @default(now())
  user         User     @relation(fields: [id_user], references: [id_user])
}

model Pedido {
  id_pedido            String    @id @default(uuid())
  owned_by_store       Boolean   @default(false)
  fecha_registro       DateTime  @default(now())
  tipo_pedido          String
  cantidad             Float
  estado_pedido        String    @default("Pendiente")
  id_user              String?
  id_lote              String?
  id_nuevoLote         String?
  id_nuevoLote_tostado String?   @unique
  id_lote_tostado      String?
  id_lote_destino      String?
  id_almacen           String?
  id_producto          String?
  comentario           String?
  pesos                Float[]
  fecha_tueste         DateTime?
  tostadora            String?
  facturado            Boolean?
  creado_por_id        String?
  completado_por_id    String?
  fecha_completado     DateTime?
  eliminado            Boolean   @default(false)

  // Relación con Usuario como Cliente
  cliente            UserCliente?        @relation("Cliente", fields: [id_user], references: [id_user])
  // Relación con Usuario como quien lo creó
  creadoPor          User?               @relation("PedidoCreadoPor", fields: [creado_por_id], references: [id_user])
  // Relación con Usuario como quien lo completó
  completadoPor      User?               @relation("PedidoCompletadoPor", fields: [completado_por_id], references: [id_user])
  // Relación con lote original
  lote               Lote?               @relation("LoteOrigen", fields: [id_lote], references: [id_lote])
  // Relación con lote creado
  loteCreado         Lote?               @relation("LoteCreado", fields: [id_nuevoLote], references: [id_lote])
  // Relación con lote de destino
  loteDestino        Lote?               @relation("LoteDestino", fields: [id_lote_destino], references: [id_lote])
  // Relación con lote tostado creado
  loteTostado        LoteTostado?        @relation("PedidoLoteTostado", fields: [id_nuevoLote_tostado], references: [id_lote_tostado])
  // Relación con lote tostado de origen
  loteTostadoOrigen  LoteTostado?        @relation("PedidoLoteTostadoOrigen", fields: [id_lote_tostado], references: [id_lote_tostado])
  // Relación con almacén
  Almacen            Almacen?            @relation("almacen", fields: [id_almacen], references: [id_almacen])
  // Relación con producto (maquila futura, empaquetado)
  producto           Producto?           @relation(fields: [id_producto], references: [id_producto])
  // Relaciones de auditoría y operación
  tueste             Tueste[]
  bolsas             Bolsa[]
  historials         Historial[]
  movimientoAlmacens MovimientoAlmacen[]
  // relaciones con pedido de bolsas 
  pedidoBolsas       PedidoBolsa[]
  pedidoItems        PedidoItem[]
  paquetesOrigen     Paquete[]           @relation("PaqueteDeEmpaque")
}

model PedidoBolsa {
  id_pedido_bolsa String @id @default(uuid())
  id_pedido       String
  gramaje         Int
  molienda        String
  cantidad        Int

  pedido Pedido @relation(fields: [id_pedido], references: [id_pedido])
}

model PedidoItem {
  id_pedido_item String            @id @default(uuid())
  id_pedido      String
  entidad        EntidadInventario
  id_entidad     String
  cantidad       Float

  pedido Pedido @relation(fields: [id_pedido], references: [id_pedido])
}

enum EstadoPaquete {
  EN_PREPARACION
  LISTO
  DESPACHADO
  CANCELADO
}

enum EstadoEnvio {
  PENDIENTE
  PROGRAMADO
  DESPACHADO
  EN_TRANSITO
  ENTREGADO
  CANCELADO
  DEVUELTO
}

enum QuienPaga {
  CLIENTE
  EMPRESA
}

model Paquete {
  id_paquete         String        @id @default(uuid())
  numero_correlativo String?       @unique
  id_cliente         String?
  id_pedido_origen   String?
  estado             EstadoPaquete @default(EN_PREPARACION)
  comentario         String?
  eliminado          Boolean       @default(false)
  fecha_registro     DateTime      @default(now())
  fecha_editado      DateTime?
  owned_by_store     Boolean       @default(false)
  creado_por_id      String
  preparado_por_id   String?
  fecha_preparado    DateTime?

  cliente      UserCliente? @relation("PaqueteCliente", fields: [id_cliente], references: [id_user])
  pedidoOrigen Pedido?      @relation("PaqueteDeEmpaque", fields: [id_pedido_origen], references: [id_pedido])
  creadoPor    User         @relation("PaqueteCreadoPor", fields: [creado_por_id], references: [id_user])
  preparadoPor User?        @relation("PaquetePreparadoPor", fields: [preparado_por_id], references: [id_user])

  items  PaqueteItem[]
  envios Envio[]
}

model PaqueteItem {
  id_item       String            @id @default(uuid())
  id_paquete    String
  entidad       EntidadInventario
  id_entidad    String
  id_almacen    String
  cantidad      Float
  unidad_medida String
  gramaje       Int?
  molienda      String?
  comentario    String?

  paquete Paquete @relation(fields: [id_paquete], references: [id_paquete])
  almacen Almacen @relation(fields: [id_almacen], references: [id_almacen])
}

model Tueste {
  id_tueste                 String       @id @default(uuid())
  id_lote                   String
  tostadora                 String
  owned_by_store            Boolean      @default(false)
  id_cliente                String?
  id_pedido                 String
  densidad                  Float
  humedad                   Float
  peso_entrada              Float
  fecha_tueste              DateTime
  temperatura_entrada       Float?
  llama_inicial             Float?
  aire_inicial              Float?
  punto_no_retorno          Float?
  tiempo_despues_crack      Float?
  temperatura_crack         Float?
  temperatura_salida        Float?
  tiempo_total              Float?
  porcentaje_caramelizacion Float?
  desarrollo                Float?
  grados_desarrollo         Float?
  peso_salida               Float?
  merma                     Float?
  agtrom_comercial          Float?
  agtrom_gourmet            Float?
  estado_tueste             String       @default("Pendiente")
  id_lote_tostado           String?
  eliminado                 Boolean      @default(false)
  num_batch                 Int
  balonGasFin               BalonGas[]   @relation("BalonGasTuesteFin")
  balonGasInicio            BalonGas[]   @relation("BalonGasTuesteInicio")
  loteTostado               LoteTostado? @relation(fields: [id_lote_tostado], references: [id_lote_tostado])
  pedido                    Pedido       @relation(fields: [id_pedido], references: [id_pedido])
}

model BalonGas {
  id_balon_gas       String         @id @default(uuid())
  fecha_ingreso      DateTime
  fecha_inicio_uso   DateTime?
  fecha_fin_uso      DateTime?
  id_tueste_inicio   String?
  id_tueste_fin      String?
  estado             EstadoBalonGas @default(DISPONIBLE)
  id_user_ingreso    String
  id_user_inicio_uso String?
  id_user_fin_uso    String?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  precio             Float
  tueste_fin         Tueste?        @relation("BalonGasTuesteFin", fields: [id_tueste_fin], references: [id_tueste])
  tueste_inicio      Tueste?        @relation("BalonGasTuesteInicio", fields: [id_tueste_inicio], references: [id_tueste])
  user_fin_uso       User?          @relation("BalonGasUserFinUso", fields: [id_user_fin_uso], references: [id_user])
  user_ingreso       User           @relation("BalonGasUserIngreso", fields: [id_user_ingreso], references: [id_user])
  user_inicio_uso    User?          @relation("BalonGasUserInicioUso", fields: [id_user_inicio_uso], references: [id_user])
}

model Envio {
  id_envio           String      @id @default(uuid())
  numero_correlativo String      @unique
  id_paquete         String
  estado             EstadoEnvio @default(PENDIENTE)
  eliminado          Boolean     @default(false)

  medio_envio     String?
  numero_tracking String?
  costo_envio     Float?
  quien_paga      QuienPaga?

  peso_total_kg Float?
  alto_cm       Float?
  ancho_cm      Float?
  largo_cm      Float?

  fecha_registro         DateTime  @default(now())
  fecha_programada       DateTime?
  fecha_despacho_real    DateTime?
  fecha_entrega_estimada DateTime?
  fecha_entrega_real     DateTime?

  registrado_por_id      String
  despachado_por_id      String?
  entregado_por_id       String?
  cancelado_por_id       String?
  comentario_cancelacion String?

  paquete       Paquete @relation(fields: [id_paquete], references: [id_paquete])
  registradoPor User    @relation("EnvioRegistradoPor", fields: [registrado_por_id], references: [id_user])
  despachadoPor User?   @relation("EnvioDespachadoPor", fields: [despachado_por_id], references: [id_user])
  entregadoPor  User?   @relation("EnvioEntregadoPor", fields: [entregado_por_id], references: [id_user])
  canceladoPor  User?   @relation("EnvioCanceladoPor", fields: [cancelado_por_id], references: [id_user])

  direccion DireccionEnvio?
}

model DireccionEnvio {
  id_direccion        String   @id @default(uuid())
  id_envio            String   @unique
  nombre_destinatario String
  telefono            String
  direccion           String
  distrito            String
  provincia           String
  departamento        String
  pais                String   @default("Perú")
  codigo_postal       String?
  referencia          String?
  observaciones       String?
  fecha_registro      DateTime @default(now())

  envio Envio @relation(fields: [id_envio], references: [id_envio])
}

model Lote_Analisis {
  id             String   @id @default(uuid())
  id_lote        String
  id_analisis    String
  fecha_agregado DateTime @default(now())
  analisis       Analisis @relation(fields: [id_analisis], references: [id_analisis])
  lote           Lote     @relation(fields: [id_lote], references: [id_lote])

  @@unique([id_lote, id_analisis])
}

model Muestra_Analisis {
  id             String   @id @default(uuid())
  id_muestra     String
  id_analisis    String
  fecha_agregado DateTime @default(now())
  analisis       Analisis @relation(fields: [id_analisis], references: [id_analisis])
  muestra        Muestra  @relation(fields: [id_muestra], references: [id_muestra])

  @@unique([id_muestra, id_analisis])
}

model Analisis {
  id_analisis          String             @id @default(uuid())
  fecha_registro       DateTime           @default(now())
  analisisFisico_id    String?            @unique
  analisisSensorial_id String?            @unique
  analisisDefectos_id  String?            @unique
  comentario           String?
  eliminado            Boolean            @default(false)
  analisisDefectos     AnalisisDefectos?  @relation(fields: [analisisDefectos_id], references: [id_analisis_defecto])
  analisisFisico       AnalisisFisico?    @relation(fields: [analisisFisico_id], references: [id_analisis_fisico])
  analisisSensorial    AnalisisSensorial? @relation(fields: [analisisSensorial_id], references: [id_analisis_sensorial])
  Lote                 Lote[]
  lotesHistoricos      Lote_Analisis[]
  Muestra              Muestra[]
  muestrasHistoricas   Muestra_Analisis[]
}

model AnalisisFisico {
  id_analisis_fisico        String    @id @default(uuid())
  fecha_registro            DateTime  @default(now())
  peso_muestra              Float
  peso_pergamino            Float
  wa                        Float
  temperatura_wa            Float
  humedad                   Float
  temperatura_humedad       Float
  densidad                  Float
  color_grano_verde         String
  olor                      String
  superior_malla_18         Float
  superior_malla_16         Float
  superior_malla_14         Float
  peso_defectos             Float
  quaquers                  Float?
  peso_muestra_tostada      Float?
  desarrollo                Float?
  porcentaje_caramelizacion Float?
  c_desarrollo              Float?
  comentario                String
  eliminado                 Boolean   @default(false)
  menor_malla_14            Float
  Analisis                  Analisis?
}

model AnalisisDefectos {
  id_analisis_defecto     String    @id @default(uuid())
  grano_negro             Int
  grano_agrio             Int
  grano_con_hongos        Int
  cereza_seca             Int
  materia_estrana         Int
  broca_severa            Int
  negro_parcial           Int
  agrio_parcial           Int
  pergamino               Int
  flotadores              Int
